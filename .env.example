# Postgres (Supabase, Neon, RDS...). Obrigatório.
DATABASE_URL=postgres://ondaro:ondaro@localhost:5432/ondaro_dev
# Segredo longo e aleatório (assinatura de links e cookies).
AUTH_SECRET=
# Endereço público do app (links de relatório e portal).
APP_URL=http://localhost:3100
# E-mails (separados por vírgula) que acessam /admin — administração da plataforma.
PLATFORM_ADMIN_EMAILS=
# Pasta do armazenamento privado de fotos/logos (padrão: ./.data/uploads).
STORAGE_DIR=
# Integrações opcionais — sem elas o app mostra "não conectado", nunca simula sucesso.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
RESEND_API_KEY=
EMAIL_FROM=
